# Normalize source and documentation
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Intentionally committed audiovisual test fixtures only
/tests/fixtures/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
/tests/fixtures/**/*.mkv filter=lfs diff=lfs merge=lfs -text
/tests/fixtures/**/*.webm filter=lfs diff=lfs merge=lfs -text
/tests/fixtures/**/*.wav filter=lfs diff=lfs merge=lfs -text
/tests/fixtures/**/*.flac filter=lfs diff=lfs merge=lfs -text
